@model SistemaBienestar.Web.Models.Usuario
@{ ViewData["Title"] = "Nuevo Usuario"; }

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Registro de Usuario</h3>
    </div>
    <form asp-action="Create">
        <div class="box-body">
            <div class="form-group">
                <label>Nombre Usuario</label>
                <input asp-for="NombreUsuario" class="form-control" />
                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Clave</label>
                <input asp-for="Clave" type="password" class="form-control" />
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Cargo</label>
                <select asp-for="IdCargo" class="form-control" asp-items="ViewBag.IdCargo"></select>
            </div>
            <div class="checkbox">
                <label>
                    <input asp-for="Estado" /> Activo
                </label>
            </div>
        </div>
        <div class="box-footer">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-default">Cancelar</a>
        </div>
    </form>
</div>
